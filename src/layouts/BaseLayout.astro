---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const {
  title = `${site.name} — ${site.role}`,
  description = site.intro,
  active = '',
} = Astro.props;
const canonical = new URL(withBase(Astro.url.pathname), `${site.domain.replace(/\/$/, '')}/`).toString();
---
<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1118" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/assets/favicon.svg')} />
    <link rel="stylesheet" href={withBase('/assets/site.css')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src={withBase('/assets/site.js')} defer></script>
  </body>
</html>
