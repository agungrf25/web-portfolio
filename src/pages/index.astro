---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkVisual from '../components/NetworkVisual.astro';
import { site, focusAreas, projects, toolset } from '../data/site';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/paths';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const dateLabel = (date: Date) => new Intl.DateTimeFormat('id-ID', {
  day: '2-digit', month: 'short', year: 'numeric',
}).format(date);
---
<BaseLayout active="about">
  <section class="hero-section section-shell">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <div class="eyebrow"><span class="eyebrow-line"></span> {site.role}</div>
        <h1>{site.headline.split('\n')[0]}<br />{site.headline.split('\n').slice(1).join(' ')}</h1>
        <p class="hero-description">{site.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#focus">Jelajahi portfolio <span aria-hidden="true">↘</span></a>
          <a class="text-link" href={`mailto:${site.email}`}>Hubungi saya <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-meta">
          <span><i class="availability-dot"></i> {site.availability}</span>
          <span class="meta-separator">/</span>
          <span>{site.location}</span>
        </div>
      </div>
      <div class="hero-art reveal reveal-delay-2">
        <NetworkVisual />
        <span class="art-caption">FIG. 01 — A CONNECTED WORLD</span>
      </div>
    </div>
    <div class="hero-bottom container">
      <span class="scroll-cue"><span class="scroll-cue-line"></span> SCROLL TO EXPLORE</span>
      <span class="hero-index mono">01 / 04</span>
    </div>
  </section>

  <section class="intro-strip" id="about">
    <div class="container intro-grid">
      <div class="section-kicker reveal"><span>01</span><span>ABOUT ME</span></div>
      <div class="intro-content reveal reveal-delay-1">
        <p class="intro-statement">Teknologi yang baik bukan cuma tentang koneksi yang cepat, tapi juga sistem yang <em>aman, terukur, dan bisa diandalkan.</em></p>
        <p class="intro-detail">{site.about}</p>
        <a class="underlined-link" href={`mailto:${site.email}`}>Kenalan lebih lanjut <span>↗</span></a>
      </div>
      <div class="intro-side reveal reveal-delay-2">
        <div class="side-rule"></div>
        <span class="mono">CURRENT INTERESTS</span>
        <ul>
          <li>Network Architecture</li>
          <li>Cybersecurity</li>
          <li>Cloud & Zero Trust</li>
          <li>Observability</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="focus-section section-shell" id="focus">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <div class="section-kicker"><span>02</span><span>AREAS OF FOCUS</span></div>
          <h2>Hal yang saya<br /><em>eksplorasi.</em></h2>
        </div>
        <p class="section-heading-note">Beberapa area teknis yang menjadi ruang belajar, eksplorasi, dan pengembangan kemampuan.</p>
      </div>
      <div class="focus-grid">
        {focusAreas.map((area, index) => (
          <article class:list={['focus-card', 'reveal', index === 1 && 'reveal-delay-1', index === 2 && 'reveal-delay-2']}>
            <div class="card-topline"><span class="mono">{area.number} / FOCUS</span><span class="card-arrow">↗</span></div>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
            <div class="tag-list">{area.tags.map((tag) => <span>{tag}</span>)}</div>
          </article>
        ))}
      </div>
      <div class="toolset-row reveal">
        <span class="mono toolset-label">TOOLS & ECOSYSTEM</span>
        <div class="toolset-list">{toolset.map((tool) => <span>{tool}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="projects-section section-shell" id="projects">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <div class="section-kicker"><span>03</span><span>LAB & CASE NOTES</span></div>
          <h2>Belajar dengan<br /><em>membangun.</em></h2>
        </div>
        <p class="section-heading-note">Ruang untuk merangkum eksperimen, dokumentasi lab, dan studi kasus. Konten di bawah adalah contoh awal yang bisa kamu sesuaikan.</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => (
          <article class:list={['project-card', 'reveal', index === 1 && 'reveal-delay-1', index === 2 && 'reveal-delay-2']}>
            <div class="project-graphic">
              <span class="project-index mono">{project.index}</span>
              <span class="project-mark">{project.mark}</span>
              <span class="graphic-corner corner-a"></span><span class="graphic-corner corner-b"></span>
              <span class="graphic-cross cross-a">+</span><span class="graphic-cross cross-b">+</span>
              <span class="project-orbit"></span>
            </div>
            <div class="project-info">
              <div class="project-kind">{project.kind}</div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="tag-list">{project.stack.map((item) => <span>{item}</span>)}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="articles-section section-shell" id="articles">
    <div class="container">
      <div class="section-heading articles-heading reveal">
        <div>
          <div class="section-kicker"><span>04</span><span>FIELD NOTES</span></div>
          <h2>Catatan kecil,<br /><em>insight nyata.</em></h2>
        </div>
        <div class="articles-heading-side">
          <p>Tips, trik, troubleshooting, dan hal menarik seputar dunia teknologi. Dipublikasikan saat ada yang layak dibagikan — bukan mengejar jadwal.</p>
          <a class="underlined-link" href={withBase('/articles/')}>Semua catatan <span>↗</span></a>
        </div>
      </div>
      {articles.length > 0 ? (
        <div class="article-list">
          {articles.map((article, index) => (
            <a class:list={['article-row', 'reveal', index === 1 && 'reveal-delay-1', index === 2 && 'reveal-delay-2']} href={withBase(`/articles/${article.id}/`)}>
              <span class="article-date mono">{dateLabel(article.data.pubDate)}</span>
              <span class="article-main"><span class="article-category">{article.data.category}</span><strong>{article.data.title}</strong><small>{article.data.description}</small></span>
              <span class="article-arrow">↗</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-articles"><span class="mono">NO POSTS YET</span><p>Catatan pertama sedang disiapkan. Silakan mampir lagi nanti.</p></div>
      )}
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div class="container contact-inner reveal">
      <div class="section-kicker"><span>05</span><span>GET IN TOUCH</span></div>
      <div class="contact-main">
        <p class="contact-overline">Punya ide, pertanyaan, atau ingin bertukar insight?</p>
        <h2>Mari terhubung<br /><em>dan bertumbuh.</em></h2>
        <a class="contact-email" href={`mailto:${site.email}`}>{site.email} <span>↗</span></a>
      </div>
      <div class="contact-bottom">
        <span class="mono">FIND ME AROUND THE WEB</span>
        <div class="social-links">
          {site.socials.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer">{social.label}<span>↗</span></a>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
